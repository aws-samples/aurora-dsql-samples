{
  "name": "veterinary-app",
  "version": "1.0.0",
  "private": true,
  "description": "Veterinary clinic example using Drizzle ORM with Aurora DSQL",
  "main": "dist/index.js",
  "scripts": {
    "db:generate": "aurora-dsql-drizzle generate --out ./drizzle -- --config drizzle.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc",
    "presample": "npm run build",
    "sample": "tsx src/index.ts",
    "pretest": "npm run build",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.0",
    "prettier": "4.0.0-alpha.13",
    "ts-jest": "^29.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@aws/aurora-dsql-drizzle": "^0.2.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.0"
  }
}
