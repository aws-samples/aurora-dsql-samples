{
    "compilerOptions": {
      "target": "ES6",
      "module": "node16",
      "moduleResolution": "node16",
      "types": ["node", "jest"],
      "strict": false,
      "skipLibCheck": true,
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,
      "outDir": "dist",
    },
    "include": ["./src/**/*", "./test/**/*"]
}
