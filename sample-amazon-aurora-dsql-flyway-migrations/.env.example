# Flyway on Aurora DSQL sample: environment template.
# Copy to `.env` and edit the values. The .env file is gitignored.

# Region of the Aurora DSQL cluster.
AWS_REGION=us-east-1

# Cluster hostname (without port). Format: <cluster-id>.dsql.<region>.on.aws
DSQL_ENDPOINT=REPLACE-WITH-YOUR-CLUSTER.dsql.us-east-1.on.aws

# Schema this sample migrates into. Everything it creates lives here, so its
# generic table names cannot collide with another sample's, and `make reset`
# is a single DROP SCHEMA CASCADE with a known blast radius.
#
# Must match ^[a-z_][a-z0-9_]*$. `public` is refused.
DSQL_SCHEMA=flyway_sample

# How many times scripts/run-flyway.sh runs the Flyway CLI in total when it
# hits the schema-history primary key race between parallel runs. Each retry
# waits (attempt * 2) seconds. Default: 3. Values below 1 are clamped to 1.
#
# This is separate from flyway.dsql.occMaxRetries in flyway.conf, which
# retries inside the migration transaction.
FLYWAY_RETRY=3

# OPTIONAL: explicit AWS profile instead of the ambient credentials.
# AWS_PROFILE=my-dsql-admin
